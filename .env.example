# =============================================================================
# Kindergarten Management App - Environment Variables
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env.local`:      cp .env.example .env.local
# 2. Fill in the values from your Supabase project dashboard:
#    Project Settings -> API
# 3. Never commit `.env.local` - it is already in .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase - Public (safe to expose to the browser)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public API key (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Supabase - Server only (NEVER expose to the browser / client bundle)
# -----------------------------------------------------------------------------
# Service role key - bypasses Row Level Security. Use only in server code
# (route handlers, server actions, cron jobs, admin scripts).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Base URL of this app - used for auth redirects (magic links, OAuth callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional - Android shell only (read by capacitor.config.ts at `npx cap sync`,
# not by Next.js). https:// only. Defaults to the production Vercel URL.
# CAPACITOR_SERVER_URL=https://kindergarten-management-app.vercel.app/
